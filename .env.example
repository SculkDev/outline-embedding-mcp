# KB base URL including the tenant path segment (the `/search` suffix is added
# automatically, and passing the full .../search URL also works):
KB_API_URL=https://kb.ruintech.net/sculkinternal

# Sent as the X-API-Key header
KB_API_KEY=

# Optional: base for turning a hit's relative `url` into a clickable link.
# Defaults to the origin of KB_API_URL (https://kb.ruintech.net).
# KB_DOC_BASE_URL=https://kb.ruintech.net

# Optional
KB_TIMEOUT_MS=30000

# Required only when MCP_TRANSPORT=http: shared secret clients must send as
# `Authorization: Bearer <token>`. Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=
